# 结构参考，不是可直接使用的配置。
#
# COOKIE_TOKEN_REDACTED 与 BCRYPT_HASH_REDACTED 是占位符：真值是活的凭据，
# cookie 那串能绕过 basic_auth 直达 7681/7682 两个终端，等于完整 shell 访问权。
# 真值只存在于本机 /opt/homebrew/etc/Caddyfile，不进版本库。

example.internal:8443 {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}

	# Service Worker 必须绕过任何"跳转式"登录网关。
	#
	# 下面这份用的是 basic_auth，浏览器会自动带上凭据，所以不会踩到；但换成
	# caddy-security / oauth2-proxy 这类未登录就 302 到登录页的网关时，推送
	# 铃铛会报 "Failed to register a ServiceWorker ... The script resource is
	# behind a redirect, which is disallowed" —— SW 规范规定脚本抓取遇到任何
	# 重定向就硬失败，注册期和之后浏览器周期性的 SW 更新抓取都算。
	#
	# 解法是在鉴权规则之前放行脚本本身。sw.js 是 module worker，静态 import
	# 了 notification-target.js，那次 import 也要单独抓一遍，所以两个都得放：
	#
	#     @swscript path /sw.js /notification-target.js
	#     route @swscript {
	#         reverse_proxy 127.0.0.1:7682
	#     }
	#
	# （route 只吃一个 matcher token，写成 route /sw.js /notification-target.js
	# 会报 wrong argument count，必须用命名 matcher。）
	#
	# 放行不降低安全性：这两个文件是纯前端逻辑、不含凭据，真正的订阅接口
	# api/push/* 和终端 WebSocket 仍在网关后面。

	# tmux-next: WebSocket 用 cookie 认证（浏览器 WS 握手不带 Basic Auth）
	@tmuxws path /tmux/ws
	handle @tmuxws {
		@notmuxcookie not header Cookie *ttyd_auth=COOKIE_TOKEN_REDACTED*
		respond @notmuxcookie 403
		uri strip_prefix /tmux
		reverse_proxy 127.0.0.1:7682
	}

	redir /tmux /tmux/

	# tmux-next: 其余走 Basic Auth，并种下 WS 用的 cookie
	handle_path /tmux/* {
		basic_auth {
			lcm BCRYPT_HASH_REDACTED
		}
		header +Set-Cookie "ttyd_auth=COOKIE_TOKEN_REDACTED; Path=/; Secure; HttpOnly; SameSite=Strict"
		reverse_proxy 127.0.0.1:7682
	}

	# WebSocket: authenticate by cookie (browsers send cookies on WS handshakes,
	# but do NOT send Basic Auth on WS — that is why the terminal kept dropping).
	@ws path /ws*
	handle @ws {
		@noauthcookie not header Cookie *ttyd_auth=COOKIE_TOKEN_REDACTED*
		respond @noauthcookie 403
		reverse_proxy 127.0.0.1:7681
	}

	# Everything else: Basic Auth, and on success plant the auth cookie so the
	# subsequent WebSocket handshake carries it.
	handle {
		basic_auth {
			lcm BCRYPT_HASH_REDACTED
		}
		header +Set-Cookie "ttyd_auth=COOKIE_TOKEN_REDACTED; Path=/; Secure; HttpOnly; SameSite=Strict"
		reverse_proxy 127.0.0.1:7681
	}
}
