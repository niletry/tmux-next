{
  "name": "tmux-next",
  "version": "0.1.0",
  "description": "A phone-friendly web client for tmux sessions, built on tmux control mode",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "tmux-next": "./src/index.ts"
  },
  "files": [
    "src",
    "public",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && bun test",
    "test:only": "bun test"
  },
  "dependencies": {
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
