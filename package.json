{
  "name": "tmux-next",
  "version": "0.12.0",
  "description": "A phone-friendly web client for tmux sessions, built on tmux control mode",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/niletry/tmux-next",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niletry/tmux-next.git"
  },
  "bugs": {
    "url": "https://github.com/niletry/tmux-next/security/advisories/new"
  },
  "keywords": [
    "tmux",
    "terminal",
    "web-terminal",
    "xterm",
    "mobile",
    "bun",
    "claude-code"
  ],
  "bin": {
    "tmux-next": "./src/index.ts"
  },
  "files": [
    "src",
    "public",
    "hooks",
    "extensions",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "!**/*.test.ts",
    "!**/*.integration.test.ts"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && bun test",
    "test:only": "bun test"
  },
  "dependencies": {
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "5.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2"
  }
}
